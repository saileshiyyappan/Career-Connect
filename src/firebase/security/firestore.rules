rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // GLOBAL SECURITY PRIMITIVES & HELPER FUNCTIONS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'admin' ||
        (userExists() && getUserData().get('role', '') == 'admin')
      );
    }

    function isEmployer() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'employer' ||
<<<<<<< HEAD
=======
        request.auth.token.get('email', '') == 'jr.research25@gmail.com' ||
>>>>>>> origin/main
        (userExists() && (
          getUserData().get('role', '') == 'employer' ||
          getUserData().get('role', '') == 'admin'
        ))
      );
    }

    function isCandidate() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') in ['job_seeker', 'candidate'] ||
        (userExists() && getUserData().get('role', '') in ['job_seeker', 'candidate', 'admin'])
      );
    }

    // Candidate discovery also supports legacy profiles whose role is missing,
    // but only when persisted candidate-profile evidence exists and no employer
    // attributes are present. Keep invitation authorization aligned with that
    // same eligibility decision.
    function isCandidateProfile(data) {
      return data.get('role', '') in ['job_seeker', 'candidate'] || (
        data.get('role', '') in ['', 'user', 'student'] &&
        !(data.get('companyName', '') != '' && data.get('employerPosition', '') != '') &&
        (
          data.get('resumeUrl', '') != '' ||
          data.get('resumeName', '') != '' ||
          data.get('skills', []).size() > 0 ||
          data.get('education', []).size() > 0 ||
          data.get('portfolioUrl', '') != '' ||
          data.get('githubUrl', '') != ''
        )
      );
    }

    function fieldUnchanged(fieldName) {
      return !(fieldName in request.resource.data) ||
             (fieldName in resource.data && request.resource.data[fieldName] == resource.data[fieldName]);
    }

    function isNotSuspended() {
      return !userExists() || (!('accountStatus' in getUserData()) || getUserData().accountStatus != 'suspended');
    }

    // ========================================================================
    // USERS COLLECTION
    // ========================================================================
    match /users/{userId} {
      // Authenticated users can view user profiles (needed for candidate/recruiter discovery)
