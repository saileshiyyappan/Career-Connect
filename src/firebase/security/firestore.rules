    match /news_sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    match /sync_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Immutable server-side log, written via Cloud Functions Admin SDK
    }

    // ========================================================================
    // HEALTH CHECK COLLECTION
