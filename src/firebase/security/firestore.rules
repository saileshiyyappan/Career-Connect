        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId == request.resource.data.employerId &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status in ['published', 'active'] &&
        isNotSuspended();

      // Candidates can update application details/withdraw; Employers can advance stages
