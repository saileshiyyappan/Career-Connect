              ))) ||
            (request.resource.data.type == 'invitation_response' && isCandidate() &&
              exists(/databases/$(database)/documents/notifications/$(request.resource.data.invitationId)) &&
              get(/databases/$(database)/documents/notifications/$(request.resource.data.invitationId)).data.userId == request.auth.uid &&
              get(/databases/$(database)/documents/notifications/$(request.resource.data.invitationId)).data.senderId == request.resource.data.userId) ||
            (request.resource.data.type == 'application' &&
              exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)) &&
              get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.jobId == request.resource.data.jobId &&
              ((isCandidate() &&
                get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.candidateId == request.auth.uid &&
                get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.employerId == request.resource.data.userId) ||
               (isEmployer() &&
                get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.employerId == request.auth.uid &&
                get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.candidateId == request.resource.data.userId))) ||
            (request.resource.data.type == 'interview' && isEmployer() &&
              request.resource.data.recipientId == request.resource.data.userId &&
              exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
              get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId == request.auth.uid &&
              exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
              isCandidateProfile(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data))
