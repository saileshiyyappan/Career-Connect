        ) || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
          fieldUnchanged('userId') && fieldUnchanged('senderId') && fieldUnchanged('recipientId') &&
          fieldUnchanged('type') && fieldUnchanged('invitationId') && fieldUnchanged('applicationId') && fieldUnchanged('jobId')) || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ========================================================================
    // INTERVIEWS COLLECTION
    // ========================================================================
    match /interviews/{interviewId} {
      allow get, list: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if (
        isEmployer() && request.resource.data.employerId == request.auth.uid &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.candidateId)) &&
        isCandidateProfile(get(/databases/$(database)/documents/users/$(request.resource.data.candidateId)).data)
      ) || isAdmin();
      allow update: if isAuthenticated() && (
        ((resource.data.candidateId == request.auth.uid || resource.data.employerId == request.auth.uid) &&
          fieldUnchanged('candidateId') && fieldUnchanged('employerId') && fieldUnchanged('jobId') && fieldUnchanged('applicationId')) ||
        isAdmin()
      );
      allow delete: if (
        isAuthenticated() && resource.data.employerId == request.auth.uid
      ) || isAdmin();
    }

