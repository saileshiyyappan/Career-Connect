          request.resource.data.senderId == request.auth.uid &&
          (
            (request.resource.data.type == 'invitation' && isEmployer() &&
              exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
              isCandidateProfile(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data) &&
              request.resource.data.recipientId == request.resource.data.userId &&
              (!('jobId' in request.resource.data) || (
