      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ========================================================================
    // COMPANIES COLLECTION
    // ========================================================================
    match /companies/{companyId} {
      // Public directory view for job seekers and visitors
      allow get, list: if true;

      // Only employers and admins can create companies; cannot self-verify
      allow create: if (
        isEmployer() &&
        (request.resource.data.ownerId == request.auth.uid || request.resource.data.employerId == request.auth.uid) &&
        (request.resource.data.verificationStatus != 'verified' || isAdmin())
      ) || isAdmin();

      // Company owner can update info, but cannot alter verificationStatus or ownership
      allow update: if (
        isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.employerId == request.auth.uid) &&
        fieldUnchanged('ownerId') &&
        fieldUnchanged('employerId') &&
        (fieldUnchanged('verificationStatus') || isAdmin())
      ) || isAdmin();

      allow delete: if (
        isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.employerId == request.auth.uid)
      ) || isAdmin();
    }

    // ========================================================================
    // JOBS COLLECTION
    // ========================================================================
    match /jobs/{jobId} {
      // Public view for active/published jobs; owners and admins can view any state
      allow get, list: if resource.data.status == 'published' ||
                          resource.data.status == 'active' ||
                          (isAuthenticated() && resource.data.employerId == request.auth.uid) ||
                          isAdmin();

      // Only employers can create jobs for their own employerId
      allow create: if (
        isEmployer() &&
        request.resource.data.employerId == request.auth.uid &&
        (request.resource.data.status != 'flagged' || isAdmin())
      ) || isAdmin();

      // Employers can update their own jobs; cannot modify employerId
      allow update: if (
        isAuthenticated() &&
        resource.data.employerId == request.auth.uid &&
        fieldUnchanged('employerId')
      ) || isAdmin();

      allow delete: if (
        isAuthenticated() &&
        resource.data.employerId == request.auth.uid
      ) || isAdmin();
    }

    // ========================================================================
    // APPLICATIONS COLLECTION
    // ========================================================================
    match /applications/{applicationId} {
      // Only the candidate, the employer, or admins can read an application
      allow get, list: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );

      // Candidates can submit applications for themselves
